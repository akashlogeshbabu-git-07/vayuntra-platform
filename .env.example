# =============================================================================
# Vayuntra Platform — Environment Configuration Template
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# --- Application Core ---
APP_ENV=development                          # development | staging | production
APP_VERSION=0.1.0
APP_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_32
DEBUG=false
LOG_LEVEL=INFO

# --- Backend API ---
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RATE_LIMIT_PER_MINUTE=100
CORS_ORIGINS=http://localhost:3000,https://app.vayuntra.io

# --- Database (PostgreSQL on 3clouds.in) ---
DB_HOST=your-db-host.3clouds.in
DB_PORT=5432
DB_NAME=vayuntra
DB_USER=vayuntra_app
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=require
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Redis (Event streaming + cache) ---
REDIS_URL=redis://your-redis-host.3clouds.in:6379/0
REDIS_PASSWORD=CHANGE_ME
REDIS_SSL=true
REDIS_POOL_SIZE=10

# --- TimescaleDB (Time-series behavioral data) ---
TIMESCALE_HOST=your-timescale-host.3clouds.in
TIMESCALE_PORT=5432
TIMESCALE_DB=vayuntra_ts
TIMESCALE_USER=vayuntra_ts_app
TIMESCALE_PASSWORD=CHANGE_ME

# --- MinIO / Object Storage (3clouds.in) ---
S3_ENDPOINT=https://s3.3clouds.in
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_ML_MODELS=vayuntra-ml-models
S3_BUCKET_ARTIFACTS=vayuntra-artifacts
S3_BUCKET_LOGS=vayuntra-audit-logs
S3_REGION=ap-south-1

# --- JWT Authentication ---
JWT_SECRET_KEY=CHANGE_ME_USE_openssl_rand_hex_64
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- ML Services ---
ML_SERVICE_URL=http://ml-service:8001
ML_MODEL_REGISTRY_PATH=/models
ANOMALY_DETECTION_THRESHOLD=0.75
BEHAVIORAL_MEMORY_WINDOW_DAYS=90
MODEL_DRIFT_THRESHOLD=0.05
RETRAINING_TRIGGER_SAMPLES=10000

# --- Local LLM (Mistral 7B) ---
LLM_ENABLED=true
LLM_MODEL_PATH=/models/mistral-7b-instruct-v0.2.Q4_K_M.gguf
LLM_CONTEXT_LENGTH=4096
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1
LLM_N_THREADS=8
LLM_N_GPU_LAYERS=0                          # Set >0 if GPU available
LLM_CLOUD_FALLBACK=true                     # Use cloud LLM when local unavailable
LLM_CLOUD_ENDPOINT=https://api.mistral.ai/v1
LLM_CLOUD_API_KEY=CHANGE_ME

# --- Agent Communication ---
AGENT_SHARED_SECRET=CHANGE_ME_USE_openssl_rand_hex_32
AGENT_HEARTBEAT_INTERVAL=60
AGENT_TELEMETRY_BATCH_SIZE=100
AGENT_MTLS_CERT_PATH=/certs/agent-ca.crt
WEBSOCKET_URL=wss://control.vayuntra.io/ws

# --- Kafka (Event streaming) ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_USERNAME=CHANGE_ME
KAFKA_PASSWORD=CHANGE_ME
KAFKA_TOPIC_TELEMETRY=vayuntra.telemetry
KAFKA_TOPIC_ALERTS=vayuntra.alerts
KAFKA_TOPIC_REMEDIATION=vayuntra.remediation

# --- Vault (Secrets management) ---
VAULT_ADDR=https://vault.vayuntra.io
VAULT_TOKEN=CHANGE_ME
VAULT_MOUNT_PATH=vayuntra

# --- Monitoring ---
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_URL=https://grafana.vayuntra.io
SENTRY_DSN=CHANGE_ME
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- Multi-tenant ---
TENANT_ISOLATION_MODEL=namespace          # namespace | cluster
MAX_TENANTS_PER_CLUSTER=50

# --- Email (Alerts) ---
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=CHANGE_ME
ALERT_FROM_EMAIL=alerts@vayuntra.io

# --- Feature Flags ---
FEATURE_LLM_REMEDIATION=true
FEATURE_AUTO_ISOLATION=true
FEATURE_BEHAVIORAL_MEMORY=true
FEATURE_THREAT_INTEL_FEED=false
FEATURE_AIRGAP_SYNC=false

# Allowed hosts (comma-separated, * for all)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (override in production)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vayuntra
